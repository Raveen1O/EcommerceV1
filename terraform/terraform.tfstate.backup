            "dashboard_arn": "arn:aws:cloudwatch::726101441380:dashboard/Raveen-cloudwatch-dashboard",
            "dashboard_body": "{\"widgets\":[{\"height\":1,\"properties\":{\"markdown\":\"# 🛒 Ecommerce Platform Monitoring Dashboard\\nGlobal overview of microservices, API Gateway, and frontend metrics.\"},\"type\":\"text\",\"width\":24,\"x\":0,\"y\":0},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/ApiGateway\",\"Count\",\"ApiId\",\"jw0yvet0t5\",{\"stat\":\"Sum\"}],[\".\",\"4xx\",\".\",\".\",{\"color\":\"#d13212\",\"stat\":\"Sum\"}],[\".\",\"5xx\",\".\",\".\",{\"color\":\"#d13212\",\"stat\":\"Sum\"}]],\"region\":\"ap-southeast-1\",\"stacked\":false,\"title\":\"API Gateway: Requests \u0026 Errors\",\"view\":\"timeSeries\"},\"type\":\"metric\",\"width\":12,\"x\":0,\"y\":1},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/ApiGateway\",\"Latency\",\"ApiId\",\"jw0yvet0t5\",{\"stat\":\"Average\"}]],\"region\":\"ap-southeast-1\",\"stacked\":false,\"title\":\"API Gateway: Latency (ms)\",\"view\":\"timeSeries\"},\"type\":\"metric\",\"width\":12,\"x\":12,\"y\":1},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/Cognito\",\"SignInSuccesses\",\"UserPool\",\"ap-southeast-1_cPDXNClGu\",\"UserPoolClient\",\"kubkbo5ehb5850ej5a5g9ilqu\",{\"stat\":\"Sum\"}]],\"region\":\"ap-southeast-1\",\"stacked\":false,\"title\":\"Cognito: Successful Sign-Ins\",\"view\":\"timeSeries\"},\"type\":\"metric\",\"width\":12,\"x\":0,\"y\":7},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/CloudFront\",\"Requests\",\"Region\",\"Global\",{\"stat\":\"Sum\"}],[\".\",\"4xxErrorRate\",\".\",\".\",{\"color\":\"#d13212\",\"stat\":\"Average\"}],[\".\",\"5xxErrorRate\",\".\",\".\",{\"color\":\"#d13212\",\"stat\":\"Average\"}]],\"region\":\"us-east-1\",\"stacked\":false,\"title\":\"CloudFront: Global Traffic \u0026 Error Rates\",\"view\":\"timeSeries\"},\"type\":\"metric\",\"width\":12,\"x\":12,\"y\":7},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/SNS\",\"NumberOfMessagesPublished\",\"TopicName\",\"payment-topic-raveen\",{\"stat\":\"Sum\"}],[\".\",\"NumberOfNotificationsFailed\",\".\",\".\",{\"color\":\"#d13212\",\"stat\":\"Sum\"}]],\"region\":\"ap-southeast-1\",\"stacked\":false,\"title\":\"SNS (Payment): Messages \u0026 Failures\",\"view\":\"timeSeries\"},\"type\":\"metric\",\"width\":12,\"x\":0,\"y\":13},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/SQS\",\"ApproximateNumberOfMessagesVisible\",\"QueueName\",\"Order-update-raveen\",{\"label\":\"Order Update (Visible)\",\"stat\":\"Average\"}],[\".\",\"ApproximateNumberOfMessagesNotVisible\",\".\",\".\",{\"color\":\"#ff7f0e\",\"label\":\"Order Update (Not Visible)\",\"stat\":\"Average\"}],[\"AWS/SQS\",\"ApproximateNumberOfMessagesVisible\",\"QueueName\",\"inventory-queue-raveen\",{\"label\":\"Inventory (Visible)\",\"stat\":\"Average\"}],[\".\",\"ApproximateNumberOfMessagesNotVisible\",\".\",\".\",{\"color\":\"#d13212\",\"label\":\"Inventory (Not Visible)\",\"stat\":\"Average\"}]],\"region\":\"ap-southeast-1\",\"stacked\":false,\"title\":\"SQS: Queue Visibility\",\"view\":\"timeSeries\"},\"type\":\"metric\",\"width\":12,\"x\":12,\"y\":13},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/Lambda\",\"Invocations\",\"FunctionName\",\"raveen-product_service\",{\"stat\":\"Sum\"}],[\".\",\"Errors\",\".\",\".\",{\"color\":\"#d13212\",\"stat\":\"Sum\"}],[\".\",\"Throttles\",\".\",\".\",{\"color\":\"#ff7f0e\",\"stat\":\"Sum\"}]],\"region\":\"ap-southeast-1\",\"stacked\":false,\"title\":\"Lambda: Product Service (Traffic \u0026 Errors)\",\"view\":\"timeSeries\"},\"type\":\"metric\",\"width\":12,\"x\":0,\"y\":19},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/Lambda\",\"Duration\",\"FunctionName\",\"raveen-product_service\",{\"stat\":\"Average\"}]],\"region\":\"ap-southeast-1\",\"stacked\":false,\"title\":\"Lambda: Product Service (Duration)\",\"view\":\"timeSeries\"},\"type\":\"metric\",\"width\":12,\"x\":12,\"y\":19},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/Lambda\",\"Invocations\",\"FunctionName\",\"raveen-order_service\",{\"stat\":\"Sum\"}],[\".\",\"Errors\",\".\",\".\",{\"color\":\"#d13212\",\"stat\":\